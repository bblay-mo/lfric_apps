!> @brief Calculate aviation diagnostics.

module aviation_diags_alg_mod

  use config_mod,                only: config_type
  use field_mod,                 only: field_type
  use tropopause_diags_alg_mod,  only: tropopause_diags_alg

  implicit none
  private

  public :: aviation_diags_alg

contains

  !> @brief   Calculate aviation diagnostics.
  !> @details Umbrella for aviation-related diagnostics. Currently wraps
  !>          the tropopause diagnostics only.
  !> @param[in] config        Application namelist configuration object.
  !> @param[in] theta         Potential temperature.
  !> @param[in] exner_in_wth  Exner pressure on Wtheta space.
  subroutine aviation_diags_alg(config, theta, exner_in_wth)

    implicit none

    type(config_type), intent(in) :: config
    type(field_type),  intent(in) :: theta, exner_in_wth

    ! Tropopause height, temperature, pressure and ICAO height.
    call tropopause_diags_alg(config, theta, exner_in_wth)

  end subroutine aviation_diags_alg

end module aviation_diags_alg_mod
